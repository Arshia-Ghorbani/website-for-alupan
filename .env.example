# ---------------------------------------------------------------------------
# Copy to .env and fill in.  .env is git-ignored and never baked into an image.
#   Generate a key:  python -c "import secrets;print(secrets.token_urlsafe(64))"
# ---------------------------------------------------------------------------

# --- Django ---------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me-generate-a-64-char-random-string
DJANGO_DEBUG=True
# Keep 'localhost' in the list even in production: the container HEALTHCHECK
# calls http://localhost:8000/health/live/ and Django rejects unknown hosts.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
DJANGO_LOG_LEVEL=INFO
DJANGO_ADMIN_URL=admin/
SITE_DOMAIN=alupan.com

# --- PostgreSQL -----------------------------------------------------------
POSTGRES_DB=alupan
POSTGRES_USER=alupan
POSTGRES_PASSWORD=change-me-too
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgres://alupan:change-me-too@db:5432/alupan

# --- Redis / Celery -------------------------------------------------------
REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# --- Email ----------------------------------------------------------------
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL="Alupan <noreply@alupan.com>"
ADMIN_EMAIL=webmaster@alupan.com
SALES_NOTIFICATION_EMAILS=sales@alupan.com

# --- Production only ------------------------------------------------------
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SECURE_HSTS_SECONDS=31536000
# SENTRY_DSN=
